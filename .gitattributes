* text=auto
*.sh text eol=lf

# Git LFS for binary assets, as in PongMobilePrototype (see docs/design/README.md).
# Existing history is not rewritten; the rules apply to files added from now on.
Assets/EmberThrone/**/*.png filter=lfs diff=lfs merge=lfs -text
Assets/EmberThrone/**/*.jpg filter=lfs diff=lfs merge=lfs -text
Assets/EmberThrone/**/*.psd filter=lfs diff=lfs merge=lfs -text
Assets/EmberThrone/**/*.tga filter=lfs diff=lfs merge=lfs -text
Assets/EmberThrone/**/*.wav filter=lfs diff=lfs merge=lfs -text
Assets/EmberThrone/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
Assets/EmberThrone/**/*.ogg filter=lfs diff=lfs merge=lfs -text
Assets/EmberThrone/**/*.ttf filter=lfs diff=lfs merge=lfs -text
Assets/EmberThrone/**/*.otf filter=lfs diff=lfs merge=lfs -text
Assets/EmberThrone/**/*.fbx filter=lfs diff=lfs merge=lfs -text
Assets/EmberThrone/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
Assets/EmberThrone/**/*.webm filter=lfs diff=lfs merge=lfs -text
