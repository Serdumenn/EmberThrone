.et-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("../Fonts/Baloo2-ExtraBold.ttf");
    font-size: var(--font-size-body);
    color: var(--color-ink);
}

.et-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.et-safe {
    position: absolute;
}

.et-hidden {
    display: none;
}

.unity-label {
    padding: 0;
    margin: 0;
}

.et-title {
    color: var(--color-gold);
    font-size: var(--font-size-title);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 7px;
    -unity-text-outline-color: var(--color-outline);
    text-shadow: 0 5px 0 var(--color-outline);
}

.et-title--display {
    font-size: var(--font-size-display);
    -unity-text-outline-width: 8px;
    text-shadow: 0 6px 0 var(--color-outline);
}

.et-outlined {
    color: var(--color-white);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--color-outline);
    text-shadow: 0 3px 0 var(--color-outline);
}

.et-ink {
    color: var(--color-ink);
    -unity-text-align: middle-center;
}

.et-ink--muted {
    color: var(--color-ink-muted);
}

.et-caption {
    font-size: var(--font-size-caption);
    -unity-font-definition: url("../Fonts/Baloo2-Bold.ttf");
}

.et-panel {
    background-image: url("../Chrome/panel.png");
    -unity-slice-left: 60;
    -unity-slice-top: 60;
    -unity-slice-right: 60;
    -unity-slice-bottom: 60;
    padding: var(--space-4) var(--space-4) 42px var(--space-4);
}

.et-tag {
    position: absolute;
    top: -40px;
    left: 50%;
    translate: -50% 0;
    height: 76px;
    padding: 0 var(--space-6) 4px var(--space-6);
    justify-content: center;
    background-image: url("../Chrome/tag.png");
    -unity-slice-left: 35;
    -unity-slice-top: 35;
    -unity-slice-right: 35;
    -unity-slice-bottom: 35;
    font-size: 46px;
    white-space: nowrap;
}

.et-chip {
    height: 70px;
    padding: 0 var(--space-4) 4px var(--space-4);
    justify-content: center;
    background-image: url("../Chrome/chip.png");
    -unity-slice-left: 32;
    -unity-slice-top: 32;
    -unity-slice-right: 32;
    -unity-slice-bottom: 32;
    color: var(--color-white);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.et-ring {
    width: 196px;
    height: 203px;
    align-items: center;
    justify-content: center;
    padding-bottom: 8px;
    background-image: url("../Chrome/ring.png");
}

.et-ribbon {
    position: absolute;
    top: -96px;
    left: -70px;
    right: -70px;
    height: 190px;
    justify-content: center;
    padding-bottom: 26px;
    background-image: url("../Chrome/ribbon.png");
    -unity-slice-left: 160;
    -unity-slice-right: 160;
}

.et-scrim {
    background-color: var(--color-scrim);
}

.et-fx-glow {
    position: absolute;
    background-image: url("../Chrome/fx_glow.png");
}

.et-fx-rays {
    position: absolute;
    opacity: 0.85;
    background-image: url("../Chrome/fx_rays.png");
}

.et-btn {
    margin: 0;
    padding: 0 var(--space-6) 12px var(--space-6);
    border-width: 0;
    height: 170px;
    align-items: center;
    justify-content: center;
    background-color: var(--color-none);
    -unity-slice-left: 70;
    -unity-slice-top: 70;
    -unity-slice-right: 70;
    -unity-slice-bottom: 70;
    font-size: var(--font-size-button);
    color: var(--color-white);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 5px;
    white-space: nowrap;
    transition-property: scale;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.et-btn:active {
    scale: 0.94 0.94;
    -unity-background-image-tint-color: var(--color-pressed);
}

.et-btn:disabled {
    opacity: 0.45;
}

.et-btn--cta {
    background-image: url("../Chrome/btn_green.png");
    -unity-text-outline-color: var(--color-cta-edge);
    text-shadow: 0 4px 0 var(--color-cta-edge);
}

.et-btn--secondary {
    background-image: url("../Chrome/btn_orange.png");
    -unity-text-outline-color: var(--color-accent-edge);
    text-shadow: 0 4px 0 var(--color-accent-edge);
}

.et-pressable {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: var(--color-none);
    transition-property: scale;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.et-pressable:active {
    scale: 0.94 0.94;
    -unity-background-image-tint-color: var(--color-pressed);
}

.et-check {
    width: 72px;
    height: 72px;
    background-image: url("../Chrome/check.png");
}

.et-icon {
    -unity-background-scale-mode: scale-to-fit;
}

.et-star {
    background-image: url("../Art/ui_star_empty.png");
    -unity-background-scale-mode: scale-to-fit;
}

.et-confetti {
    position: absolute;
    left: 0;
    top: 0;
    width: 22px;
    height: 40px;
    border-radius: 4px;
}

.et-confetti--square {
    width: 26px;
    height: 26px;
}

.et-confetti--round {
    width: 26px;
    height: 26px;
    border-radius: 13px;
}

.et-confetti--red {
    background-color: var(--color-alert);
}

.et-confetti--gold {
    background-color: var(--color-gold);
}

.et-confetti--green {
    background-color: var(--color-cta);
}

.et-confetti--blue {
    background-color: var(--color-confetti-blue);
}

.et-confetti--purple {
    background-color: var(--color-confetti-purple);
}

.et-confetti--orange {
    background-color: var(--color-accent);
}

.et-confetti--white {
    background-color: var(--color-white);
}

.et-star--on {
    background-image: url("../Art/ui_star.png");
}
