}

.et-pass__cell {
    width: 280px;
    height: 120px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    opacity: 0.55;
}

.et-pass__cell--ready {
    opacity: 1;
    scale: 1.06 1.06;
}

.et-pass__cell--claimed {
    opacity: 0.3;
}

.et-pass__cell--locked {
    opacity: 0.35;
}

.et-pass__icon {
    width: 96px;
    height: 96px;
}

.et-pass__amount {
    font-size: var(--font-size-body);
    margin-left: var(--space-2);
}

.et-level-start__streak {
