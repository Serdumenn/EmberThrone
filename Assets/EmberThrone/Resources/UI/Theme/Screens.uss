    -unity-slice-left: 40;
    -unity-slice-top: 40;
    -unity-slice-right: 40;
    -unity-slice-bottom: 48;
}

.et-rank--me {
    -unity-background-image-tint-color: var(--color-gold);
}

.et-rank__place {
    width: 92px;
    flex-shrink: 0;
    font-size: 52px;
}

.et-rank__medal {
    width: 92px;
    height: 92px;
    flex-shrink: 0;
}

.et-rank__name {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    font-size: 46px;
    color: var(--color-ink);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
}

.et-rank__trophy {
    width: 60px;
    height: 60px;
    margin-left: 12px;
    flex-shrink: 0;
}

.et-rank__points {
    min-width: 100px;
    flex-shrink: 0;
    font-size: 48px;
    -unity-text-align: middle-right;
}

.et-rank__points--short {
    min-width: 56px;
}

.et-avatar {
    width: 96px;
    height: 96px;
    margin: 0 18px 0 8px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 48px;
    border-width: 5px;
    border-color: var(--color-gold-deep);
    background-color: var(--color-face-deep);
}

.et-avatar__art {
    width: 74px;
    height: 74px;
}

.et-avatar--row {
    width: 116px;
    height: 116px;
    margin: 0 20px 0 0;
    border-radius: 58px;
}

.et-avatar--row > .et-avatar__art {
    width: 90px;
    height: 90px;
}

.et-avatar--big {
    width: 170px;
    height: 170px;
    margin: 0 22px 0 0;
    border-radius: 85px;
    border-width: 7px;
}

.et-avatar--big > .et-avatar__art {
    width: 132px;
    height: 132px;
}

.et-side__button--event {
    margin-top: 6px;
    margin-bottom: 40px;
}

.et-side__chip {
    position: absolute;
    left: 50%;
    bottom: -30px;
    translate: -50% 0;
    height: 54px;
    padding: 0 18px 4px 18px;
    font-size: 30px;
}

.et-event__top {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.et-event__texts {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    align-items: flex-start;
}

.et-event__hint {
    margin-top: 10px;
    -unity-text-align: upper-left;
    white-space: nowrap;
}

.et-event__points {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.et-event__token {
    width: 84px;
    height: 84px;
    margin-right: 12px;
}

.et-event__points-text {
    font-size: var(--font-size-button);
}

.et-event__tier {
    height: 128px;
    padding: 0 14px 8px 16px;
}

.et-event__need {
    flex-direction: row;
    align-items: center;
    width: 170px;
    flex-shrink: 0;
}

.et-event__need-icon {
    width: 54px;
    height: 54px;
    margin-right: 6px;
}

.et-event__need-text {
    font-size: 42px;
}

.et-event__rewards {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.et-event__reward {
    flex-direction: row;
    align-items: center;
    margin-right: 10px;
}

.et-event__reward-icon {
    width: 58px;
    height: 58px;
    margin-right: 4px;
}

.et-event__reward-text {
    font-size: 36px;
}

.et-event__slot {
    width: 170px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.et-event__claim {
    min-width: 164px;
    height: 100px;
}

.et-event__lock {
    width: 58px;
    height: 58px;
}

.et-event__goal {
    margin-bottom: 10px;
}

.et-event__bar {
    height: 64px;
    margin: 0 0 14px 0;
}

.et-event__note {
    margin-bottom: 18px;
}

.et-video {
    -unity-background-scale-mode: scale-and-crop;
}

.et-video__screen {
    -unity-background-scale-mode: scale-and-crop;
}

.et-story {
    background-color: var(--color-board-back);
}

.et-story__title {
    position: absolute;
    top: 60px;
    left: 32px;
    height: 92px;
    padding: 0 var(--space-6) 6px var(--space-6);
    font-size: var(--font-size-label);
}

.et-story__caption {
    position: absolute;
    left: 60px;
    right: 60px;
    bottom: 110px;
    height: auto;
    min-height: 100px;
    padding: 20px var(--space-6) 26px var(--space-6);
    font-size: 42px;
    white-space: normal;
}

.et-story__skip {
    position: absolute;
    right: 32px;
    top: 50px;
    min-width: 190px;
}

.et-district__play {
    position: absolute;
    right: 20px;
    bottom: 18px;
    width: 104px;
    height: 104px;
}

.et-diorama {
    overflow: hidden;
}

.et-diorama__frame {
    position: absolute;
}

.et-diorama__image {
    -unity-background-scale-mode: stretch-to-fill;
}

.et-diorama__area {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.et-diorama__glow {
    position: absolute;
    opacity: 0;
}

.et-side--right {
    left: auto;
    right: 26px;
}

.et-restore__hint {
    margin-bottom: var(--space-2);
    white-space: normal;
}

.et-restore__row {
    height: 140px;
}

.et-restore__thumb {
    overflow: hidden;
}

.et-restore__thumb-art {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.et-restore__thumb--frozen > .et-restore__thumb-art {
    -unity-background-image-tint-color: var(--color-locked);
}

.et-restore__prize {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 0 12px;
}

.et-restore__prize-icon {
    width: 64px;
    height: 64px;
    margin-right: 6px;
}

.et-restore__prize-text {
    font-size: 42px;
}

.et-restore__bonus {
    align-items: center;
    margin: var(--space-2) 0 var(--space-3) 0;
}

.et-restore__bonus-row {
    flex-direction: row;
    justify-content: center;
}

.et-reward__chest-holder {
    align-items: center;
    justify-content: center;
}

.et-reward__flash {
    left: 50%;
    top: 50%;
    width: 520px;
    height: 520px;
    margin-left: -260px;
    margin-top: -260px;
}

.et-pill__warn {
    top: auto;
    bottom: -44px;
    height: 56px;
    padding: 0 22px 4px 22px;
    font-size: 30px;
}

.et-contest__emblem {
    width: 170px;
    height: 170px;
    margin-right: 22px;
    flex-shrink: 0;
}

.et-contest__prizes {
    margin-top: 0;
    margin-bottom: 16px;
}

.et-contest__bar {
    margin: 0 0 16px 0;
}

.et-contest__list {
    max-height: 620px;
    margin-bottom: var(--space-3);
}

.et-contest__result {
    margin-bottom: 8px;
}

.et-ladder__pool {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.et-ladder__trophy {
    width: 130px;
    height: 130px;
    margin-right: 16px;
    flex-shrink: 0;
}

.et-ladder__pool-texts {
    align-items: flex-start;
}

.et-ladder__pool-amount {
    font-size: 60px;
    color: var(--color-gold-light);
}

.et-ladder__share {
    -unity-text-align: middle-left;
}

.et-ladder {
    align-items: center;
    margin-bottom: 12px;
}

.et-ladder__step {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 92px;
    margin-bottom: 6px;
    padding-bottom: 8px;
    background-image: url("../Chrome/row.png");
    -unity-slice-left: 40;
    -unity-slice-top: 40;
    -unity-slice-right: 40;
    -unity-slice-bottom: 48;
    -unity-background-image-tint-color: var(--color-locked);
}

.et-ladder__step--done {
    -unity-background-image-tint-color: var(--color-gold);
}

.et-ladder__step--next {
    -unity-background-image-tint-color: var(--color-accent);
}

.et-ladder__number {
    font-size: 46px;
}

.et-ladder__check {
    width: 58px;
    height: 58px;
    margin-left: 16px;
}

.et-ladder__mascot {
    width: 74px;
    height: 74px;
    margin-left: 16px;
}

.et-chest {
    height: 280px;
}

.et-chest__icon {
    width: 160px;
    height: 160px;
    margin-right: 18px;
    flex-shrink: 0;
}

.et-chest__bar {
    margin: 8px 0 14px 0;
}

.et-chest__steps {
    flex-direction: row;
}

.et-chest__step {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    justify-content: center;
    height: 80px;
}

.et-chest__check {
    width: 62px;
    height: 62px;
}

.et-chest__need {
    padding: 0 18px 4px 18px;
}
