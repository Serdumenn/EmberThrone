.et-backdrop--map {
    background-image: url("../Art/bg_map.jpg");
    -unity-background-scale-mode: scale-and-crop;
}

.et-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    flex-direction: row;
    align-items: flex-start;
    padding: 26px var(--space-3) 0 var(--space-3);
}

.et-hud__left {
    width: 210px;
    align-items: center;
}

.et-emby__face {
    position: absolute;
    left: 6px;
    right: 6px;
    top: -18px;
    bottom: 14px;
    -unity-background-scale-mode: scale-to-fit;
    transform-origin: center bottom;
}

.et-hud__level {
    margin-top: -34px;
}

.et-hud__goals {
    flex-grow: 1;
    height: 196px;
    margin: 34px 0 0 18px;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    padding: 22px var(--space-3) 34px var(--space-3);
}

.et-hud__moves {
    width: 260px;
    height: 196px;
    margin: 34px 0 0 18px;
    align-items: center;
    justify-content: center;
    padding: 10px 0 22px 0;
}

.et-hud__moves-count {
    font-size: var(--font-size-number);
    text-shadow: 0 5px 0 var(--color-highlight);
}

.et-hud__moves-count--warn {
    color: var(--color-primary);
}

.et-hud__moves-count--danger {
    color: var(--color-alert);
}

.et-goal {
    width: 132px;
    height: 132px;
}

.et-hud__goals--four .et-goal {
    width: 104px;
    height: 104px;
}

.et-goal__count {
    position: absolute;
    right: -18px;
    bottom: -20px;
    font-size: var(--font-size-label);
}

.et-goal__check {
    position: absolute;
    right: -12px;
    bottom: -12px;
}

.et-praise {
    position: absolute;
    left: 0;
    right: 0;
    top: 36%;
    font-size: 140px;
    -unity-text-outline-width: 9px;
    text-shadow: 0 7px 0 var(--color-outline);
    rotate: -6deg;
}

.et-result {
    align-items: center;
    justify-content: center;
}

.et-result__body {
    width: 900px;
    align-items: center;
}

.et-result__glow {
    left: 30px;
    top: -200px;
    width: 840px;
    height: 760px;
}

.et-result__rays {
    left: -310px;
    top: -580px;
    width: 1520px;
    height: 1520px;
}

.et-result__stars {
    flex-direction: row;
    height: 360px;
    align-items: flex-start;
    justify-content: center;
    margin-bottom: 70px;
}

.et-result__star {
    width: 270px;
    height: 270px;
    margin: 70px -10px 0 -10px;
}

.et-result__star--left {
    rotate: -16deg;
}

.et-result__star--middle {
    width: 340px;
    height: 340px;
    margin-top: 0;
}

.et-result__star--right {
    rotate: 16deg;
}

.et-result__panel {
    align-self: stretch;
    padding: 118px var(--space-6) 40px var(--space-6);
}

.et-result__message {
    font-size: var(--font-size-label);
    white-space: normal;
    margin-bottom: 40px;
}

.et-result__button {
    margin-bottom: var(--space-3);
}

.et-result__mascot {
    position: absolute;
    left: -90px;
    bottom: -120px;
    width: 300px;
    height: 300px;
    rotate: -10deg;
    background-image: url("../Art/mascot_joy.png");
}

.et-map {
    flex-grow: 1;
}

.et-map__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.et-district {
    flex-shrink: 0;
    margin: 0 26px 30px 26px;
    padding: 18px 18px 26px 18px;
}

.et-district__art {
    height: 330px;
    border-radius: 34px;
    -unity-background-scale-mode: scale-and-crop;
}

.et-district__art--1 {
    background-image: url("../Art/district_1.jpg");
}

.et-district__art--2 {
    background-image: url("../Art/district_2.jpg");
}

.et-district__art--3 {
    background-image: url("../Art/district_3.jpg");
}

.et-district__art--4 {
    background-image: url("../Art/district_4.jpg");
}

.et-district__art--5 {
    background-image: url("../Art/district_5.jpg");
}

.et-district__art--6 {
    background-image: url("../Art/district_6.jpg");
}

.et-district__art--7 {
    background-image: url("../Art/district_7.jpg");
}

.et-district__art--8 {
    background-image: url("../Art/district_8.jpg");
}

.et-district__art--9 {
    background-image: url("../Art/district_9.jpg");
}

.et-district__art--10 {
    background-image: url("../Art/district_10.jpg");
}

.et-district--locked > .et-district__art {
    -unity-background-image-tint-color: var(--color-locked);
}

.et-district__title {
    position: absolute;
    left: 18px;
    bottom: 16px;
    height: 78px;
    padding: 0 var(--space-6) 6px var(--space-6);
    font-size: var(--font-size-body);
}

.et-district__lock {
    position: absolute;
    right: 24px;
    top: 20px;
    width: 110px;
    height: 110px;
}

.et-district__progress {
    flex-direction: row;
    align-items: center;
    margin: 18px 10px 4px 10px;
}

.et-district__bar {
    flex-grow: 1;
    margin: 0 20px 0 0;
}

.et-district__star {
    width: 66px;
    height: 66px;
    margin-right: 8px;
}

.et-district__stars {
    min-width: 70px;
    font-size: var(--font-size-body);
    -unity-text-align: middle-left;
}

.et-district__grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 26px;
}

.et-map-node {
    width: 140px;
    height: 140px;
    margin: 14px 18px 40px 18px;
    align-items: center;
    justify-content: center;
    background-color: var(--color-none);
    border-width: 0;
}

.et-map-node__ring {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("../Chrome/ring.png");
    -unity-background-scale-mode: scale-to-fit;
}

.et-map-node__number {
    font-size: 60px;
    color: var(--color-white);
    -unity-text-align: middle-center;
    -unity-font-definition: url("../Fonts/Baloo2-ExtraBold.ttf");
    margin-bottom: 6px;
}

.et-map-node__stars {
    position: absolute;
    bottom: -26px;
    flex-direction: row;
    display: none;
}

.et-map-node__star {
    width: 50px;
    height: 50px;
    margin: 0 -3px;
}

.et-map-node__mascot {
    position: absolute;
    top: -128px;
    width: 150px;
    height: 150px;
    background-image: url("../Art/mascot.png");
}

.et-map-node--done .et-map-node__stars {
    display: flex;
}

.et-map-node--locked .et-map-node__ring {
    background-image: url("../Chrome/ring_locked.png");
}

.et-map-node--locked .et-map-node__number {
    opacity: 0.6;
}

.et-map-node--current {
    scale: 1.16 1.16;
}

.et-level-start__hard {
    position: relative;
    top: 0;
    left: 0;
    translate: 0 0;
    align-self: center;
    margin: var(--space-3) 0 var(--space-2) 0;
}

.et-level-start__hard--super {
    -unity-background-image-tint-color: var(--color-alert);
}

.et-shop__list {
    max-height: 1180px;
    margin-bottom: var(--space-3);
}

.et-reward-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: var(--space-3);
}

.et-pass__status {
    font-size: var(--font-size-label);
    -unity-text-align: middle-center;
}

.et-pass__note {
    color: var(--color-ink-muted);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: var(--space-3);
}

.et-pass__head {
    flex-direction: row;
    justify-content: space-between;
    margin: var(--space-2) 60px var(--space-2) 60px;
}

.et-pass__col {
    color: var(--color-ink);
}

.et-pass__col--premium {
    color: var(--color-primary);
}

.et-pass__list {
    max-height: 900px;
    margin-bottom: var(--space-3);
}

.et-pass__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 150px;
    margin-bottom: 8px;
    padding: 0 16px 8px 16px;
    background-image: url("../Chrome/row.png");
    -unity-slice-left: 40;
    -unity-slice-top: 40;
    -unity-slice-right: 40;
    -unity-slice-bottom: 46;
}

.et-pass__step {
    font-size: var(--font-size-label);
