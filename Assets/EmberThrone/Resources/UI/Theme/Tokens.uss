:root {
    --color-primary-light: #FF9440;
    --color-primary: #E2541A;
    --color-primary-deep: #A3330C;
    --color-outline: #4A1604;
    --color-nav-top: #B4400F;
    --color-nav-bottom: #6A1F06;
    --color-face: #FFF8E9;
    --color-face-deep: #FFE5BB;
    --color-ink: #6A2A0A;
    --color-ink-muted: #86532A;
    --color-gold-light: #FFF7C4;
    --color-gold: #FFD447;
    --color-gold-deep: #B96A05;
    --color-title: #FFE48A;
    --color-cream-text: #FEF5D4;
    --color-purple-edge: #400D5D;
    --color-purple-ink: #56107E;
    --color-blue-edge: #0B2550;
    --color-value-ink: #730C0F;
    --color-crimson-edge: #742721;
    --color-nav-floor: #6A0E26;
    --color-header-top: #5E0C16;
    --color-page: #1B2444;
    --color-off-edge: #3A3448;
    --color-cta: #44AD1C;
    --color-cta-edge: #18480A;
    --color-accent: #F2780E;
    --color-accent-edge: #6A2A04;
    --color-alert: #E8102A;
    --color-alert-edge: #5A0610;
    --color-chip: rgba(30, 16, 48, 0.9);
    --color-white: #FFFFFF;
    --color-highlight: rgba(255, 255, 255, 0.9);
    --color-scrim: rgba(10, 5, 25, 0.78);
    --color-board-back: #131A4A;
    --color-tile: #34459A;
    --color-tile-alt: #2B3A88;
    --color-select: #7AD83A;
    --color-pressed: #EBEBEB;
    --color-locked: #BDB8CC;
    --color-confetti-blue: #2F8CFF;
    --color-confetti-purple: #B44AF6;
    --color-none: rgba(0, 0, 0, 0);

    --font-size-display: 112px;
    --font-size-number: 116px;
    --font-size-title: 92px;
    --font-size-button: 68px;
    --font-size-label: 50px;
    --font-size-body: 44px;
    --font-size-caption: 34px;

    --space-1: 8px;
    --space-2: 16px;
    --space-3: 24px;
    --space-4: 32px;
    --space-6: 48px;
    --space-8: 64px;
    --space-12: 96px;
}
